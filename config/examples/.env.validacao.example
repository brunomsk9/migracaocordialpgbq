PG_HOST=/var/run/postgresql
PG_PORT=5432
PG_USER=postgres
PG_PASSWORD=
PG_SSLMODE=prefer
PG_CONNECT_TIMEOUT=15
PG_ADMIN_DATABASE=postgres
PG_STATEMENT_TIMEOUT_MS=0
PG_DATABASES=
PG_SCHEMAS=
PG_EXCLUDE_DATABASES=
PG_EXCLUDE_SCHEMAS=
BQ_PROJECT=seu-projeto-gcp
BQ_LOCATION=southamerica-east1
GOOGLE_APPLICATION_CREDENTIALS=
VALIDATION_OUTPUT_DIR=/opt/migracao/validation
VALIDATION_COUNT_MODE=exact
# Deixe vazio para gerar apenas o relatório local.
VALIDATION_BQ_TABLE=
VALIDATION_GCS_URI=
VALIDATION_MAPPING_FILE=
