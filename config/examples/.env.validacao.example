PG_HOST=/var/run/postgresql
PG_PORT=5432
PG_USER=postgres
PG_PASSWORD=
PG_SSLMODE=prefer
PG_CONNECT_TIMEOUT=15
PG_ADMIN_DATABASE=postgres
PG_STATEMENT_TIMEOUT_MS=0
PG_DATABASES=
PG_SCHEMAS=
PG_EXCLUDE_DATABASES=
PG_EXCLUDE_SCHEMAS=
# Use o mesmo valor definido para a migração, para validar os mesmos objetos.
PG_SKIP_PARTITION_CHILDREN=false
# Troque pelo Project ID real do GCP (ex.: sv-443512), não o nome de exibição.
# Deixar o valor de exemplo abaixo causa erro 404 do BigQuery ao rodar o script.
BQ_PROJECT=seu-projeto-gcp
BQ_LOCATION=southamerica-east1
# Na VM GCP com Service Account, não defina GOOGLE_APPLICATION_CREDENTIALS.
# Fora da VM, se necessário: GOOGLE_APPLICATION_CREDENTIALS=/caminho/chave.json
VALIDATION_OUTPUT_DIR=/opt/migracao/validation
VALIDATION_COUNT_MODE=exact
# Deixe vazio para gerar apenas o relatório local. Se preencher, use o mesmo
# Project ID de BQ_PROJECT acima: project.dataset.tabela (ex.: sv-443512.monitoramento.validacao_migracao).
VALIDATION_BQ_TABLE=
VALIDATION_GCS_URI=
VALIDATION_MAPPING_FILE=
