# Configuração por VM. Não substitua um .env existente sem revisar os valores.
PG_HOST=/var/run/postgresql
PG_PORT=5432
PG_USER=postgres
PG_PASSWORD=
PG_SSLMODE=prefer
PG_CONNECT_TIMEOUT=15
PG_ADMIN_DATABASE=postgres
PG_DEFAULT_SRID=
PG_STATEMENT_TIMEOUT_MS=0
AUTO_DISCOVER=true
PG_DATABASES=
PG_SCHEMAS=
PG_EXCLUDE_DATABASES=
PG_EXCLUDE_SCHEMAS=
# true evita migrar/validar cada partição filha além da tabela particionada
# pai, que já contém todas as linhas (economiza leitura e evita dados em duplicidade).
PG_SKIP_PARTITION_CHILDREN=false
BQ_PROJECT=seu-projeto-gcp
BQ_LOCATION=southamerica-east1
# Na VM GCP com Service Account, não defina GOOGLE_APPLICATION_CREDENTIALS.
# Fora da VM, se necessário: GOOGLE_APPLICATION_CREDENTIALS=/caminho/chave.json
BATCH_SIZE=2000
BATCH_PAUSE_SECONDS=0.2
MAX_RETRIES=3
RETRY_DELAY_SECONDS=2
MAX_TABLE_BYTES=0
MAX_ROWS_PER_TABLE=0
TABLE_ORDER=smallest
CHECKPOINT_FILE=/opt/migracao/state/migration-checkpoint.json
RESUME=false
WRITE_MODE=truncate
LOG_LEVEL=INFO
FAIL_FAST=false
